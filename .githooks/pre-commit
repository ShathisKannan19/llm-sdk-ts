#!/bin/sh
# Pre-commit validation for llm-sdk-ts.
# Runs automatically once `npm install` has set core.hooksPath (see the
# "prepare" script in package.json). Bypass in an emergency with:
#   git commit --no-verify
set -e

run() {
  # run "<label>" <cmd...> : quiet on success, full output on failure
  label=$1
  shift
  printf '[pre-commit] %s ... ' "$label"
  if out=$("$@" 2>&1); then
    printf 'ok\n'
  else
    printf 'FAILED\n\n%s\n' "$out"
    exit 1
  fi
}

run "typecheck (src + tests + scripts)" npm run --silent typecheck
run "tests" npm test --silent

# Keep package-lock.json in step with package.json whenever it changes.
if git diff --cached --name-only | grep -qx 'package.json'; then
  run "lockfile refresh" npm install --package-lock-only --no-audit --no-fund
  if ! git diff --quiet -- package-lock.json; then
    printf '\n[pre-commit] package-lock.json is out of date.\n'
    printf '            Run `npm install`, `git add package-lock.json`, then commit again.\n\n' >&2
    exit 1
  fi
fi

printf '[pre-commit] passed\n'
